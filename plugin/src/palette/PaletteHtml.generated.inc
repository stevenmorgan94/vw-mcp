<body>
<header class="strip"><span class="state"><span class="dot" id="sdot"></span><span id="shead">Checking…</span></span><span class="who" id="swho"></span></header>
<nav class="tabs" role="tablist">
  <button role="tab" data-tab="status" aria-selected="true">Status</button>
