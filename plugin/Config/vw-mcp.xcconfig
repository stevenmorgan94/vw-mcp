// Build settings for vw-mcp.vwlibrary. Every SDK path goes through VW_SDK_DIR, so nothing here
// depends on where the SDK or this repo lives.
//
// VW_YEAR     Vectorworks year to build for. Each year needs its own binary (Vectorworks rejects a
//             module whose SDK_VERSION isn't its own). Default 2027.
// VW_SDK_DIR  The Vectorworks SDK for that year: the folder that holds SDKLib/.
//             Default: a VectorworksSDK/SDK<year> folder next to this repo's checkout.
//
// Override either one by:
//   - the environment, for tools/build-plugin.sh   (VW_SDK_DIR=/path/to/SDK2027 tools/build-plugin.sh)
//   - the xcodebuild command line                 (xcodebuild ... VW_SDK_DIR=/path/to/SDK2027)
//   - plugin/Config/Local.xcconfig (gitignored), for builds from the Xcode app.

VW_YEAR = 2027
VW_SDK_DIR = $(SRCROOT)/../../VectorworksSDK/SDK$(VW_YEAR)

// Output: <repo>/build/<year>/<config>/vw-mcp.vwlibrary
SYMROOT = $(SRCROOT)/../build/$(VW_YEAR)
OBJROOT = $(SYMROOT)/obj

PRODUCT_NAME = vw-mcp
PRODUCT_BUNDLE_IDENTIFIER = io.github.stevenmorgan94.vw-mcp
WRAPPER_EXTENSION = vwlibrary
INFOPLIST_FILE = Info.plist

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO

// Mirrors the SDK's NNA_StdBuild_Native / NNA_PluginBuild settings (not included directly,
// because an xcconfig #include can't take a variable path).
CLANG_CXX_LANGUAGE_STANDARD = c++20
CLANG_CXX_LIBRARY = libc++
CLANG_ENABLE_OBJC_ARC = YES
CLANG_ENABLE_MODULES = YES
GCC_INPUT_FILETYPE = sourcecode.cpp.objcpp
GCC_SYMBOLS_PRIVATE_EXTERN = NO
GCC_INLINES_ARE_PRIVATE_EXTERN = NO
GCC_PREFIX_HEADER = src/Prefix.h
GCC_PRECOMPILE_PREFIX_HEADER = YES
OTHER_CFLAGS = $(inherited) -fpch-instantiate-templates

// The SDK needs exactly one of DEV_BLD / RELEASE_BLD. The public SDK ships only a Release
// libVWSDK.a (DEV_BLD pulls in debug symbols it doesn't have), so both configurations use
// RELEASE_BLD; Debug differs only in optimisation and symbols.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) RELEASE_BLD=1

HEADER_SEARCH_PATHS = "$(VW_SDK_DIR)/SDKLib/Include" "$(VW_SDK_DIR)/SDKLib/Include/Kernel" "$(VW_SDK_DIR)/SDKLib/Include/OnlyMac" "$(VW_SDK_DIR)/SDKLib/Include/Interfaces" "$(VW_SDK_DIR)/SDKLib/Include/VWMM" "$(SRCROOT)/src"
LIBRARY_SEARCH_PATHS = "$(VW_SDK_DIR)/SDKLib/LibMac/Release"
FRAMEWORK_SEARCH_PATHS = "$(VW_SDK_DIR)/SDKLib/LibMac/Release"
OTHER_LDFLAGS = -lVWSDK -framework VWMM -framework Cocoa -framework Carbon

// Debug symbols in Debug only.
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
GCC_OPTIMIZATION_LEVEL_Debug = 0
GCC_OPTIMIZATION_LEVEL_Release = s
GCC_OPTIMIZATION_LEVEL = $(GCC_OPTIMIZATION_LEVEL_$(CONFIGURATION))

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -

#include? "Local.xcconfig"
